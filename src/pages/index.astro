<script>
    const menuItems = new Map([
        ['projects', document.getElementById('menu-projects')],
        ['contributions', document.getElementById('menu-contributions')],
        ['about', document.getElementById('menu-about')],
    ]);
    function menuSelect(selected) {
        const item = menuItems.get(selected);
        if (item == null) {
            return;
        }
        menuItems.forEach(el => el.classList.remove('current'));
        item.classList?.add?.('current');
    }
    function hashUpdate() {
        if (window.location.hash?.length > 1) {
            menuSelect(window.location.hash.substring(1));
        }
    }
    hashUpdate();
    window.addEventListener('hashchange', hashUpdate);

    const sections = new Map([
        ["projects", document.getElementById("projects")],
        ["contributions", document.getElementById("contributions")],
        ["about", document.getElementById("about")],
    ]);
    menuItems.forEach(el => el.addEventListener("click", ev => {
        if (window.location.hash?.length > 1 ||
            !(ev.currentTarget.dataset?.ehSection?.length > 0) ||
            ev.button !== 0 || ev.ctrlKey || ev.shiftKey || ev.metaKey
        ) {
            return;
        }
        const section = sections.get(ev.currentTarget.dataset.ehSection);
        if (section == null) {
            return;
        }
        ev.preventDefault();
        section.scrollIntoView?.({
            behavior: "smooth",
            block: "start",
        });
    }));

    const intersecting = new Map([
        ["projects", false],
        ["contributions", false],
        ["about", false],
    ]);
    const observer = new IntersectionObserver(
        entries => entries.forEach(entry => {
            if (entry?.target?.id != null) {
                intersecting.set(entry.target.id, entry.isIntersecting)
                if (intersecting.get("about")) {
                    menuSelect("about");
                } else if (intersecting.get("contributions")) {
                    menuSelect("contributions");
                } else {
                    menuSelect("projects");
                }
            }
        }),
        { rootMargin: '0px 0px -75% 0px' }
    );
    sections.forEach(el => {
        if (el != null) {
            observer.observe(el);
        }
    });
</script>
<script>
    document.getElementById("to-dark-theme").addEventListener("click", () => {
        document.documentElement.classList.remove("theme-light");
        document.documentElement.classList.add("theme-dark");
        if (window.localStorage) {
            localStorage.setItem("eh:theme", "dark");
        }
    });
    document.getElementById("to-light-theme").addEventListener("click", () => {
        document.documentElement.classList.remove("theme-dark");
        document.documentElement.classList.add("theme-light");
        if (window.localStorage) {
            localStorage.setItem("eh:theme", "light");
        }
    });
</script>
<script>
    const backlightCt = document.getElementById("trans-dots-backlight-ct");
    const backlightRacecar = document.getElementById("trans-dots-backlight-racecar");
    const observer = new IntersectionObserver(
        entries => entries.forEach(entry => {
            if (entry?.target?.id == "ct-art") {
                backlightCt.style.opacity = entry.isIntersecting ? "0.7" : "0";
            } else if (entry?.target?.id == "racecar-art") {
                backlightRacecar.style.opacity = entry.isIntersecting ? "0.7" : "0";
            }
        }),
        { rootMargin: '0px 0px -90% 0px' }
    );
    observer.observe(document.getElementById("ct-art"));
    observer.observe(document.getElementById("racecar-art"));
</script>
