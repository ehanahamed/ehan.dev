---
import Layout from '../layouts/Layout.astro';
import QzfrGridMotion from "../components/grid-motion/QuizfreelyGridMotion";
import CodebergIcon from '../components/icons/Codeberg.astro';
import GitHubIcon from '../components/icons/GitHub.astro';
import LinkedinIcon from '../components/icons/Linkedin.astro';
---
<style>
.customgridlist {
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
}
@media only screen and (max-width: 1000px) {
    .customgridlist {
        grid-template-columns: 1fr;
    }
}
</style>
<style is:global>
    :root {
        --eh-bg--1: #eceff3;
    }
    .only-light-theme,
    .grid-motion__tile img.only-light-theme {
        display: block;
    }
    .only-dark-theme,
    .grid-motion__tile img.only-dark-theme {
        display: none;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --eh-bg--1: var(--bg-0);
        }
        .only-light-theme,
        .grid-motion__tile img.only-light-theme {
            display: none;
        }
        .only-dark-theme,
        .grid-motion__tile img.only-dark-theme {
            display: block;
        }
    }
</style>
<Layout>
    <div class="grid page" style="margin-top: 0px; padding-top:3rem; padding-bottom:0;">
        <div class="content">
            <p style="font-size: 1.6rem;">Hi, I'm</p>
            <h1 style="margin-top: 0px;">Ehan</h1>
        </div>
    </div>
    <!--<div class="wave-bottom extra-bg"></div>-->
    <div class="grid page" style="background-color: var(--eh-bg--1); padding-top: 3rem; padding-bottom: 8rem;">
        <div class="content">
            <div class="flex">
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">Codeberg:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://codeberg.org/ehanahamed">
                        <CodebergIcon></CodebergIcon>
                        ehanahamed
                    </a>
                </div>
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">GitHub:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://github.com/ehanahamed">
                        <GitHubIcon></GitHubIcon>
                        ehanahamed
                    </a>
                </div>
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">LinkedIn:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://linkedin.com/in/ehanahamed">
                        <LinkedinIcon></LinkedinIcon>
                        ehanahamed
                    </a>
                </div>
                <!-- <div> -->
                <!--     <p class="fg0" style="padding-left: 0.8rem;">Email:</p> -->
