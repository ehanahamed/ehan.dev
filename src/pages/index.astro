                            <div class="flex" style="position: absolute; z-index: 2; inset: 0; align-items: center; justify-content: center; pointer-events: none;">
                                <div class="flex" style="align-items: center; gap: 1rem; flex-wrap: nowrap;">
                                    <img src={MITRacecarNeoLogo.src} alt="MIT Racecar Neo" style="width: 2.4rem; height: 2.4rem;" />
                                    <span style="font-size: 2rem; font-weight: bold; text-shadow: 0px 0px 10px var(--eh-bg--1); pointer-events: auto;">MIT Racecar Neo</span>
                                </div>
                            </div>
                            <Hyperspeed
                                client:load
