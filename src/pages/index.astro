---
import Layout from '../layouts/Layout.astro';
import QzfrGridMotion from "../components/QuizfreelyGridMotion.jsx";
import Hyperspeed from "../components/hyperspeed/Hyperspeed.jsx";
import CodebergIcon from '../components/icons/Codeberg.astro';
import GitHubIcon from '../components/icons/GitHub.astro';
import LinkedinIcon from '../components/icons/Linkedin.astro';
import QuizfreelyLogo from '../assets/quizfreely-logo.svg';
import CtjsLogotype from '../assets/ct-js-logotype.svg';
import MITRacecarNeoLogo from '../assets/mit-racecar-neo-logo.png';
import LightSunIcon from '../components/icons/LightSun.astro';
import DarkMoonIcon from '../components/icons/DarkMoon.astro';
---
<style>
    .top-menu-link {
        margin-top: 0px;
        color: var(--fg-0);
        padding: 0.4rem 0.8rem;
        border-radius: 0.8rem;
        font-size: 1.1rem;
        text-shadow: 0px 0px 10px var(--eh-bg--1);
    }
    .top-menu-link:hover {
        background-color: var(--bg-3ish);
        box-shadow: 0px 1px 2px 1px var(--button-box-shadow-color);
    }
    .top-menu-link.current {
        color: var(--main);
        background-color: var(--bg-3ish);
        box-shadow: 0px 1px 2px 1px var(--button-box-shadow-color);
    }
    .top-menu-link.current:hover {
        color: var(--main-alt);
    }
    .eh-content-on-bg--1 .box {
        background-color: var(--bg-1);
        border-color: var(--bg-1);
    }
    .customgridlist {
        gap: 1rem;
        grid-template-columns: 1fr 1fr;
    }
    @media only screen and (max-width: 1000px) {
        .customgridlist {
            grid-template-columns: 1fr;
        }
    }
    @media only screen and (max-width: 550px) {
        #oss-contributions-txt {
            display: none;
        }
    }
</style>
<style is:global>
    :root {
        --eh-bg--1: #f4f2ee;
    }
    body {
        background-color: var(--eh-bg--1);
    }
    .only-light-theme,
    .grid-motion__tile img.only-light-theme,
    .theme-dark only-dark-theme, 
    .theme-dark .grid-motion__tile img.only-dark-theme {
        display: block;
    }
    .only-light-theme.flex,
    .theme-dark .only-dark-theme.flex {
        display: flex;
    }
    .only-dark-theme,
    .only-dark-theme.flex,
    .grid-motion__tile img.only-dark-theme,
    .theme-dark .only-light-theme,
    .theme-dark .only-light-theme.flex,
    .theme-dark .grid-motion__tile img.only-light-theme {
        display: none;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --eh-bg--1: var(--bg-0);
        }
        .only-light-theme,
        .only-light-theme.flex,
        .grid-motion__tile img.only-light-theme,
        .theme-light .only-dark-theme,
        .theme-light .only-dark-theme.flex,
        .theme-light .grid-motion__tile img.only-dark-theme {
            display: none;
        }
        .only-dark-theme,
        .grid-motion__tile img.only-dark-theme,
        .theme-light .only-light-theme,
        .theme-light .grid-motion__tile img.only-light-theme {
            display: block;
        }
        .only-dark-theme.flex,
        .theme-light .only-light-theme.flex {
            display: flex;
        }
    }
</style>
<Layout title="Ehan Ahamed">
    <div class="flex" style="align-items: center; justify-content: end; padding: 1rem; background-color: var(--bg-1);">
        <div class="flex" style="flex-direction: column; gap: 0; align-items: center; justify-content: start;">
            <button class="icon-only-button only-light-theme" style="padding: 0.6rem;" id="to-dark-theme">
                <DarkMoonIcon width="1.4rem" height="1.4rem" style="display: block;" />
            </button>
            <button class="icon-only-button only-dark-theme" style="padding: 0.6rem;" id="to-light-theme">
                <LightSunIcon width="1.4rem" height="1.4rem" style="display: block;" />
            </button>
            <p class="fg0" style="font-size: 0.8rem;">Light / Dark</p>
        </div>
    </div>
    <div class="grid page" style="margin-top: 0px; padding-top:1rem; padding-bottom:0; position: relative; width: 100%; background-color: var(--bg-1);">
        <div class="content" style="z-index: 2; height: 6rem;">
            <div class="flex" style="height: 100%; flex-direction: row; align-items: end; padding-bottom: 2rem;">
                <h1 style="margin-top: 0px;">Ehan A</h1>
            </div>
        </div>
    </div>
    <div class="grid page eh-content-on-bg--1" style="background-color: var(--eh-bg--1); padding-top: 3rem; margin-top: 0px; padding-bottom: 2rem;">
        <div class="content">
            <div class="flex">
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">Codeberg:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://codeberg.org/ehanahamed">
                        <CodebergIcon></CodebergIcon>
                        ehanahamed
                    </a>
                </div>
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">GitHub:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://github.com/ehanahamed">
                        <GitHubIcon></GitHubIcon>
                        ehanahamed
                    </a>
                </div>
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">LinkedIn:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://linkedin.com/in/ehanahamed">
                        <LinkedinIcon></LinkedinIcon>
                        ehanahamed
                    </a>
                </div>
                <!-- <div> -->
                <!--     <p class="fg0" style="padding-left: 0.8rem;">Email:</p> -->
                <!--     <div style="margin-top: 0px; padding: 0.6rem 1rem;"> -->
                <!--         ehan@ehan.dev -->
                <!--     </div> -->
                <!-- </div> -->
            </div>
        </div>
    </div>
    <div class="grid page trans-dots" style="--trans-dots-color: var(--eh-bg--1); margin-top: 0; position: sticky; top: 0; z-index: 10; height: 4rem;">
        <div class="content" style="height: 100%;">
            <div style="display: flex; height: 100%; align-items: center; padding-left: 1rem; gap: 0.6rem;">
                <a class="top-menu-link current" id="menu-projects" href="#projects" data-eh-section="projects">Projects</a>
                <a class="top-menu-link" id="menu-contributions" href="#contributions" data-eh-section="contributions"><span id="oss-contributions-txt">Open-Source</span> Contributions</a>
                <a class="top-menu-link" id="menu-about" href="#about" data-eh-section="about">About</a>
            </div>
        </div>
    </div>
    <div class="grid page eh-content-on-bg--1" style="background-color: var(--eh-bg--1); margin-top: 0; padding-bottom: 8rem;">
        <div class="content">
            <div id="projects">
                <div style="position: relative; width: 100%; height: 24rem;">
                    <div class="flex" style="position: absolute; z-index: 3; top: 0; left: 0; right: 0; bottom: 0; align-items: center; justify-content: center; flex-wrap: nowrap; pointer-events: none;">
                        <QuizfreelyLogo height="4rem" style="filter: drop-shadow(0px 0px 10px var(--eh-bg--1));" />
                        <span style="font-size: 2rem; font-weight: bold; text-shadow: 0px 0px 10px var(--eh-bg--1); pointer-events: auto;">Quizfreely</span>
                        <!-- <p style="font-size: 1.2rem;">Free and open-source studying tool</p> -->
                        <!-- <p style="font-size: 1.2rem;">Used by 25,000+ students & teachers</p> -->
                    </div>
                    <div style="position: absolute; z-index: 1; top: 0; left: 0; right: 0; bottom: 0;">
