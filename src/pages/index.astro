---
import Layout from '../layouts/Layout.astro';
import QzfrGridMotion from "../components/QuizfreelyGridMotion.jsx";
import Hyperspeed from "../components/hyperspeed/Hyperspeed.jsx";
import CodebergIcon from '../components/icons/Codeberg.astro';
import GitHubIcon from '../components/icons/GitHub.astro';
import LinkedinIcon from '../components/icons/Linkedin.astro';
import QuizfreelyLogo from '../assets/quizfreely-logo.svg';
import CtjsLogotype from '../assets/ct-js-logotype.svg';
import MITRacecarNeoLogo from '../assets/mit-racecar-neo-logo.png';
import LightSunIcon from '../components/icons/LightSun.astro';
import DarkMoonIcon from '../components/icons/DarkMoon.astro';
import GlobeIcon from '../components/icons/Globe.astro';
---
<style>
    .top-menu-link {
        margin-top: 0px;
        color: var(--fg-0);
        padding: 0.4rem 0.8rem;
        border-radius: 0.8rem;
        font-size: 1.1rem;
        text-shadow: 0px 0px 10px var(--eh-bg--1);
    }
    .top-menu-link:hover {
        background-color: var(--bg-3ish);
        box-shadow: 0px 1px 2px 1px var(--button-box-shadow-color);
    }
    .top-menu-link.current {
        color: var(--main);
        background-color: var(--bg-3ish);
        box-shadow: 0px 1px 2px 1px var(--button-box-shadow-color);
    }
    .top-menu-link.current:hover {
        color: var(--main-alt);
    }
    .box {
        border-radius: 1rem;
    }
    .eh-content-on-bg--1 .box {
        background-color: var(--bg-1);
        border-color: var(--bg-1);
        box-shadow: 0px 1px 2px 0px var(--button-box-shadow-color);
    }
    .customgridlist {
        gap: 1rem;
        grid-template-columns: 1fr 1fr;
    }
    @media only screen and (max-width: 1100px) {
        .customgridlist {
            grid-template-columns: 1fr;
        }
    }
    @media only screen and (max-width: 550px) {
        #oss-contributions-txt {
            display: none;
        }
    }
    .mit-racecar-neo-sm-font-size {
        font-size: 2rem;
    }
    @media only screen and (max-width: 500px) {
        .mit-racecar-neo-sm-font-size {
            font-size: 1.4rem;
        }
    }
    .grid.qzfr-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto;
        grid-template-areas: "content art";
        gap: 1rem;
    }
    .qzfr-grid-art {
        grid-area: art;
    }
    .qzfr-grid-content {
        grid-area: content;
    }
    @media only screen and (max-width: 1400px) {
        .grid.qzfr-grid {
            grid-template-columns: auto;
            grid-template-rows: auto auto;
            grid-template-areas: "art"
                "content";
        }
    }
    @media only screen and (max-width: 1050px) {
        .eh-optional-in-headline {
            display: none;
        }
    }
</style>
<style is:global>
    :root {
        --eh-bg--1-theme-light: #f3f4f6;
        --eh-bg--1-theme-dark: #101217;
        --racecar-bg-theme-dark: var(--eh-bg--1-theme-dark);
        --racecar-fg-theme-dark: var(--fg-1);
        --racecar-bg-theme-light: #101217;
        --racecar-fg-theme-light: #f9f9f9;
        --ct-bg-light: var(--eh-bg--1-theme-light);
        --ct-bg-dark: #ddd;

        --eh-bg--1: var(--eh-bg--1-theme-light);
        --racecar-bg: var(--racecar-bg-theme-light);
        --racecar-fg: var(--racecar-fg-theme-light);
        --ct-bg: var(--ct-bg-light);
    }
    :root.theme-dark {
        --eh-bg--1: var(--eh-bg--1-theme-dark);
        --racecar-bg: var(--racecar-bg-theme-dark);
        --racecar-fg: var(--racecar-fg-theme-dark);
        --ct-bg: var(--ct-bg-dark);
    }
    body {
        background-color: var(--eh-bg--1);
    }
    .only-light-theme,
    .grid-motion__tile img.only-light-theme,
    .theme-dark .only-dark-theme, 
    .theme-dark .grid-motion__tile img.only-dark-theme {
        display: block;
    }
    .only-dark-theme,
    .grid-motion__tile img.only-dark-theme,
    .theme-dark .only-light-theme,
    .theme-dark .grid-motion__tile img.only-light-theme {
        display: none;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --eh-bg--1: var(--eh-bg--1-theme-dark);
            --racecar-bg: var(--racecar-bg-theme-dark);
            --racecar-fg: var(--racecar-fg-theme-dark);
            --ct-bg: var(--ct-bg-dark);
        }
        :root.theme-light {
            --eh-bg--1: var(--eh-bg--1-theme-light);
            --racecar-bg: var(--racecar-bg-theme-light);
            --racecar-fg: var(--racecar-fg-theme-light);
            --ct-bg: var(--ct-bg-light);
        }
        .only-light-theme,
        .grid-motion__tile img.only-light-theme,
        .theme-light .only-dark-theme,
        .theme-light .grid-motion__tile img.only-dark-theme {
            display: none;
        }
        .only-dark-theme,
        .grid-motion__tile img.only-dark-theme,
        .theme-light .only-light-theme,
        .theme-light .grid-motion__tile img.only-light-theme {
            display: block;
        }
    }
</style>
