---
import Layout from '../layouts/Layout.astro';
import QzfrGridMotion from "../components/QuizfreelyGridMotion.jsx";
import Hyperspeed from "../components/hyperspeed/Hyperspeed.jsx";
import CodebergIcon from '../components/icons/Codeberg.astro';
import GitHubIcon from '../components/icons/GitHub.astro';
import LinkedinIcon from '../components/icons/Linkedin.astro';
import MITRacecarNeoLogo from '../assets/mit-racecar-neo-logo.png';
import CtjsLogotype from '../assets/ct-js-logotype.svg';
---
<style>
.top-menu-link {
    margin-top: 0px;
    color: var(--fg-0);
    padding: 0.4rem 0.8rem;
    border-radius: 0.8rem;
}
.top-menu-link:hover {
    background-color: var(--bg-3ish);
    box-shadow: 0px 1px 2px 1px var(--button-box-shadow-color);
}
.top-menu-link.current {
    color: var(--main);
    background-color: var(--bg-3ish);
    box-shadow: 0px 1px 2px 1px var(--button-box-shadow-color);
}
.top-menu-link.current:hover {
    color: var(--main-alt);
}
.eh-content-on-bg--1 .box {
    background-color: var(--bg-1);
    border-color: var(--bg-1);
}
.customgridlist {
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
}
.customgridlist-item-top,
.customgridlist-item-top-optional {
    height: 12rem;
}
@media only screen and (max-width: 1000px) {
    .customgridlist {
        grid-template-columns: 1fr;
    }
    .customgridlist-item-top-optional {
        height: auto;
    }
}
</style>
<style is:global>
    :root {
        --eh-bg--1: #f4f2ee;
    }
    .only-light-theme,
    .grid-motion__tile img.only-light-theme {
        display: block;
    }
    .only-dark-theme,
    .grid-motion__tile img.only-dark-theme {
        display: none;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --eh-bg--1: var(--bg-0);
        }
        .only-light-theme,
        .grid-motion__tile img.only-light-theme {
            display: none;
        }
        .only-dark-theme,
        .grid-motion__tile img.only-dark-theme {
            display: block;
        }
    }
</style>
<Layout title="Ehan Ahamed">
    <div class="grid page" style="margin-top: 0px; padding-top:3rem; padding-bottom:0; position: relative; width: 100%;">
        <div class="content" style="z-index: 2; height: 10rem;">
            <div class="flex" style="height: 100%; flex-direction: row; align-items: end; padding-bottom: 2rem;">
                <h1 style="margin-top: 0px;">Ehan A</h1>
            </div>
        </div>
    </div>
    <!--<div class="wave-bottom extra-bg"></div>-->
    <div class="grid page eh-content-on-bg--1" style="background-color: var(--eh-bg--1); padding-top: 3rem; margin-top: 0px; padding-bottom: 8rem;">
        <div class="content">
            <div class="flex">
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">Codeberg:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://codeberg.org/ehanahamed">
                        <CodebergIcon></CodebergIcon>
                        ehanahamed
                    </a>
                </div>
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">GitHub:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://github.com/ehanahamed">
                        <GitHubIcon></GitHubIcon>
                        ehanahamed
                    </a>
                </div>
                <div>
                    <p class="fg0" style="padding-left: 0.8rem;">LinkedIn:</p>
                    <a class="button faint" style="margin-top: 0px;" href="https://linkedin.com/in/ehanahamed">
                        <LinkedinIcon></LinkedinIcon>
                        ehanahamed
                    </a>
                </div>
                <!-- <div> -->
                <!--     <p class="fg0" style="padding-left: 0.8rem;">Email:</p> -->
                <!--     <div style="margin-top: 0px; padding: 0.6rem 1rem;"> -->
                <!--         ehan@ehan.dev -->
                <!--     </div> -->
                <!-- </div> -->
            </div>
            <div>
                <div class="trans-dots" style="--trans-dots-color: var(--eh-bg--1); position: sticky; top: 0; z-index: 10; height: 4rem; display: flex; align-items: center; padding-left: 1rem; gap: 0.4rem;">
            <a class="top-menu-link current" href="#projects">Projects</a>
<a class="top-menu-link" href="#contributions">Open-Source Contributions</a>
            <a class="top-menu-link" href="#volunteer">Volunteer Roles</a>
                </div>
                <div style="position: relative; width: 100%; height: 24rem;">
                    <div style="position: absolute; z-index: 3; top: 0; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-wrap: nowrap;">
                        <h2 id="projects">Quizfreely</h2>
                        <p style="font-size: 1.2rem;">Free and open-source studying tool</p>
                        <p style="font-size: 1.2rem;">Used by 25,000+ students & teachers</p>
                    </div>
                    <div class="only-light-theme" style="position: absolute; z-index: 2; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--bg-0); opacity: 0.1;"></div>
                    <div style="position: absolute; z-index: 1; top: 0; left: 0; right: 0; bottom: 0;">
                        <QzfrGridMotion client:load />
</div>
                </div>
            </div>
            <!-- <div class="grid customgridlist"> -->
            <div class="box" style="width: 100%; margin-top: 0px;">
                    <!-- <h3>Quizfreely</h3> -->
